# Rotera — Environment Variables
# Copy this file to .env and fill in real values.

# ── Soroban Contract ──
VITE_SOROBAN_CONTRACT_ID=
VITE_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
VITE_SOROBAN_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# ── PostHog Analytics ──
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com

# ── Sentry Monitoring ──
VITE_SENTRY_DSN=

# ── Supabase (Feedback & Realtime) ──
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── Demo / Test Mode ──
# Set to true to show accelerated second-based test cycles in circle creation
VITE_ENABLE_TEST_CYCLES=false

